CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        mosaicCount: { value: [1, 1] }
}%

CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
    in vec2 a_uv0;
    out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
      v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%

CCProgram fs %{
  #include <texture>

  /**
  * ...
  */
  precision highp float; 
  in vec4 v_color;
  #if USE_TEXTURE
    in vec2 v_uv0;
    uniform sampler2D texture;
  #endif

  /**
  * ...
  */
  uniform Properties {
    vec4 uvRect;
    vec2 mosaicCount;
  };

  /**
  * ...
  */
  vec2 normalizeUV(inout vec2 out_uv) {
    out_uv.x = (out_uv.x - uvRect.x) / uvRect.z;
    out_uv.y = (out_uv.y - uvRect.y) / uvRect.w;
    return out_uv;
  }

  /**
  * ...
  */
  vec2 getRectMosaicUV(vec2 in_uv) {
    vec2 uv_size = uvRect.zw / mosaicCount;
    in_uv = floor(in_uv / uv_size) * uv_size + uv_size * 0.5;
    return in_uv;
  }
  
  /**
  * ...
  */
  void main () {
    vec4 o = vec4(1, 1, 1, 1);
    #if USE_TEXTURE
      vec2 real_uv = getRectMosaicUV(v_uv0);
      CCTexture(texture, real_uv, o);
    #endif

    o *= v_color;
    gl_FragColor = o.rgba;
  }

}%
