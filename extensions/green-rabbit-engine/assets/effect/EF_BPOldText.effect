CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        edgeWear: { value: 0.3, range: [0, 1] }
        inkNoise: { value: 0.2, range: [0, 1] }
}%

CCProgram vs %{
  precision highp float;
  #include <cc-global>

  in vec3 a_position;
  in vec2 a_uv0;
  out vec2 v_uv0;

  void main () {
    v_uv0 = a_uv0;
    gl_Position = cc_matViewProj * vec4(a_position, 1);
  }
}%


CCProgram fs %{
  precision highp float;
  #include <cc-global>

  uniform sampler2D texture;
  uniform Properties {
    float edgeWear;
    float inkNoise;
  };

  in vec2 v_uv0;

  // 笔画残缺效果
  float strokeDefect(vec2 uv, float alpha) {
    vec2 coord = uv * 100.0;
    float defect = 0.0;
    
    // 横向笔画残缺
    defect += smoothstep(0.7, 0.9, 
             sin(coord.x * 0.5 + sin(coord.y * 0.3) * 3.0) * 0.5 + 0.5);
    
    // 纵向笔画残缺
    defect += smoothstep(0.8, 0.95, 
             fract(sin(coord.y * 0.7) * 43758.5453));
    
    return min(1.0, defect * edgeWear * alpha);
  }

  // 墨水不均匀效果
  float inkVariation(vec2 uv) {
    vec2 iuv = floor(uv * 300.0);
    float variation = fract(sin(dot(iuv, vec2(12.9898,78.233))) * 43758.5453);
    return mix(0.8, 1.2, variation) * inkNoise;
  }

  void main () {
    vec4 col = texture2D(texture, v_uv0);
     
    // 墨水浓度变化
    float inkVar = inkVariation(v_uv0);
    col.rgb *= mix(1.0, inkVar, col.a);
    
    // 笔画残缺效果
    float defect = strokeDefect(v_uv0, col.a);
    col.a *= 1.0 - defect;
    
    // 边缘自然过渡
    col.rgb *= col.a;
    
    gl_FragColor = col;
  }
}%