CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        hue : { value: 0, inspector : { displayName : "色相 [0-359] offset" } }
        saturation : { value : 1.0, inspector : { displayName : "饱和度 [0-3.0] multiply" } }
        value : { value : 1.0, inspector : { displayName : "色调 [0-3.0] multiply" } }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
    in vec2 a_uv0;
    out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
      v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;

  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
    in vec2 v_uv0;
    uniform sampler2D texture;
  #endif

  uniform Properties {
    vec4 uvRect;
    float hue;
    float saturation;
    float value;
  };

  vec2 localUV(in vec2 in_uv) {
    vec2 out_uv;
    out_uv.x = (in_uv.x - uvRect.x) / uvRect.z;
    out_uv.y = (in_uv.y - uvRect.y) / uvRect.w;
    return out_uv;
  }

  vec2 defaultUV(in vec2 in_uv) {
    vec2 out_uv;
    out_uv.x = in_uv.x * uvRect.z + uvRect.x;
    out_uv.y = in_uv.y * uvRect.w + uvRect.y;
    return out_uv;
  }

  vec3 RGBConvertToHSV(vec3 rgb) {
    float r = rgb.x, g = rgb.y, b = rgb.z;
    
    float maxVal = max(r, max(g, b));
    float minVal = min(r, min(g, b));
    vec3 hsv = vec3(0.0, 0.0, maxVal);

    float delta = maxVal - minVal;
    if (maxVal != 0.0) {
        hsv.y = delta / maxVal;
    }
    else {
        return hsv;
    }

    if (r == maxVal) {
      hsv.x = (g - b) / delta;
    }
    if (g == maxVal) {
      hsv.x = 2.0 + (b - r) / delta;
    }
    if (b == maxVal) {
      hsv.x = 4.0 + (r - g) / delta;
    }

    hsv.x = hsv.x * 60.0;   
    if (hsv.x < 0.0) {
      hsv.x = hsv.x + 360.0;
    }

    return hsv;
  }

  vec3 HSVConvertToRGB(vec3 hsv) {
    float c = hsv.y * hsv.z;
    float h = hsv.x / 60.0;
    float x = c * (1.0 - abs(mod(h, 2.0) - 1.0));
    float m = hsv.z - c;

    vec3 rgb;
     if (0.0 <= h && h < 1.0) {
        rgb = vec3(c, x, 0.0);
    }
    else if (1.0 <= h && h < 2.0) {
        rgb = vec3(x, c, 0.0);
    }
    else if (2.0 <= h && h < 3.0) {
        rgb = vec3(0.0, c, x);
    }
    else if (3.0 <= h && h < 4.0) {
        rgb = vec3(0.0, x, c);
    }
    else if (4.0 <= h && h < 5.0) {
        rgb = vec3(x, 0.0, c);
    }
    else {
        rgb = vec3(c, 0.0, x);
    }
    return rgb + m;
  }

  void main () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      vec2 uv = v_uv0;
      o *= texture2D(texture, uv);

      vec3 colorHSV = RGBConvertToHSV(o.xyz);
      colorHSV.x += hue;
      colorHSV.x = mod(colorHSV.x, 360.0);
      colorHSV.y *= saturation;
      colorHSV.z *= value;

      o.xyz = HSVConvertToRGB(colorHSV.xyz); 
    #endif

    o *= v_color;

    ALPHA_TEST(o);

    #if USE_BGRA
      gl_FragColor = o.bgra;
    #else
      gl_FragColor = o.rgba;
    #endif
  }
}%
