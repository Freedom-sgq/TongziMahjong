      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\nattribute vec2 a_uv0;\nvarying vec4 v_color;\nvarying vec2 v_uv0;\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n    pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n    pos = cc_matViewProj * pos;\n  #endif\n  v_uv0 = a_uv0;\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\nuniform vec4 cc_time;\nvarying vec4 v_color;\nvarying vec2 v_uv0;\nuniform sampler2D texture;\nuniform vec4 uvRect;\nuniform float uvRotated;\nuniform float lightWidth;\nuniform float lightAngle;\nvec2 normalizeUV(in vec2 in_uv) {\n  vec2 out_uv;\n  out_uv.x = (in_uv.x - uvRect.x) / uvRect.z;\n  out_uv.y = (in_uv.y - uvRect.y) / uvRect.w;\n  out_uv = mix(out_uv, vec2(1.0 - out_uv.y, out_uv.x), step(0.5, uvRotated));\n  return out_uv;\n}\nvoid main () {\n  vec4 color = vec4(1.0);\n  vec2 uv = normalizeUV(v_uv0);\n  #if USE_TEXTURE\n    color = texture2D(texture, v_uv0);\n  #endif\n  float angleRad = radians(lightAngle);\n  vec2 lightDir = vec2(cos(angleRad), sin(angleRad));\n  float len = length(lightDir);\n  float projection = dot(uv, lightDir) + len / 0.5 * len;\n  float scanPos = mod(cc_time.x, 2.5) / len;\n  float dist = abs(projection - scanPos);\n  float intensity = smoothstep(lightWidth, 0.0, dist);\n  #if USE_TEXTURE\n    gl_FragColor = vec4(color.rgb + intensity, color.a);\n  #else\n    gl_FragColor.rgb = vec3(1.0);\n    gl_FragColor.a = intensity;\n  #endif\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\nin vec2 a_uv0;\nout vec4 v_color;\nout vec2 v_uv0;\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n    pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n    pos = cc_matViewProj * pos;\n  #endif\n  v_uv0 = a_uv0;\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nin vec4 v_color;\nin vec2 v_uv0;\nuniform sampler2D texture;\nuniform LightParams {\n  vec4 uvRect;\n  float uvRotated;\n  float lightWidth;\n  float lightAngle;\n};\nvec2 normalizeUV(in vec2 in_uv) {\n  vec2 out_uv;\n  out_uv.x = (in_uv.x - uvRect.x) / uvRect.z;\n  out_uv.y = (in_uv.y - uvRect.y) / uvRect.w;\n  out_uv = mix(out_uv, vec2(1.0 - out_uv.y, out_uv.x), step(0.5, uvRotated));\n  return out_uv;\n}\nvoid main () {\n  vec4 color = vec4(1.0);\n  vec2 uv = normalizeUV(v_uv0);\n  #if USE_TEXTURE\n    color = texture2D(texture, v_uv0);\n  #endif\n  float angleRad = radians(lightAngle);\n  vec2 lightDir = vec2(cos(angleRad), sin(angleRad));\n  float len = length(lightDir);\n  float projection = dot(uv, lightDir) + len / 0.5 * len;\n  float scanPos = mod(cc_time.x, 2.5) / len;\n  float dist = abs(projection - scanPos);\n  float intensity = smoothstep(lightWidth, 0.0, dist);\n  #if USE_TEXTURE\n    gl_FragColor = vec4(color.rgb + intensity, color.a);\n  #else\n    gl_FragColor.rgb = vec3(1.0);\n    gl_FragColor.a = intensity;\n  #endif\n}"
