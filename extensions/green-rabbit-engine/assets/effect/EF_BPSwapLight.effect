CCEffect %{
  techniques:
  - passes:
    - vert: light-vs
      frag: light-fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        lightWidth: { value: 0.2 }
        lightAngle: { value: 0.0 }
}%


CCProgram light-vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  in vec2 a_uv0;

  out vec4 v_color;
  out vec2 v_uv0;

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    v_uv0 = a_uv0;
    v_color = a_color;

    gl_Position = pos;
  }
}%

CCProgram light-fs %{
  precision highp float;
  #include <cc-global>

  in vec4 v_color;
  in vec2 v_uv0;
  uniform sampler2D texture;

  uniform LightParams {
    vec4 uvRect;
    float uvRotated;
    float lightWidth;
    float lightAngle;
  };

  vec2 normalizeUV(in vec2 in_uv) {
    vec2 out_uv;
    out_uv.x = (in_uv.x - uvRect.x) / uvRect.z;
    out_uv.y = (in_uv.y - uvRect.y) / uvRect.w;
    out_uv = mix(out_uv, vec2(1.0 - out_uv.y, out_uv.x), step(0.5, uvRotated));
    return out_uv;
  }

  void main () {
    vec4 color = vec4(1.0);
    vec2 uv = normalizeUV(v_uv0);
    #if USE_TEXTURE
      color = texture2D(texture, v_uv0);
    #endif
    
    float angleRad = radians(lightAngle);
    vec2 lightDir = vec2(cos(angleRad), sin(angleRad));
    float len = length(lightDir);
    float projection = dot(uv, lightDir) + len / 0.5 * len;
    float scanPos = mod(cc_time.x, 2.5) / len;
    float dist = abs(projection - scanPos);
    float intensity = smoothstep(lightWidth, 0.0, dist);

    #if USE_TEXTURE
      gl_FragColor = vec4(color.rgb + intensity, color.a);
    #else
      gl_FragColor.rgb = vec3(1.0);
      gl_FragColor.a = intensity;
    #endif
  }
}%