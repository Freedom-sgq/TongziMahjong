CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        center: { value: [0.5, 0.5], editor: { tooltip: '模糊中心点，本地uv' } }
        strength: { value: 0.5, editor: { tooltip: '模糊强度' } }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
      v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;

  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  #endif

  uniform Properties {
    vec4 uvRect;
    vec2 center;
    float strength;
  };

  vec2 localUV(in vec2 in_uv) {
    vec2 out_uv;
    out_uv.x = (in_uv.x - uvRect.x) / uvRect.z;
    out_uv.y = (in_uv.y - uvRect.y) / uvRect.w;
    return out_uv;
  }

  vec2 defaultUV(in vec2 in_uv) {
    vec2 out_uv;
    out_uv.x = in_uv.x * uvRect.z + uvRect.x;
    out_uv.y = in_uv.y * uvRect.w + uvRect.y;
    return out_uv;
  }

  #if USE_TEXTURE
    vec4 getRadialBlurColor(vec2 in_uv) {
      vec2 defaultCenter = defaultUV(center);
      vec2 offset = in_uv.xy - defaultCenter;

      const int samples = 10;
      float perStrength = strength / float(samples - 1);
      vec4 color = vec4(0.0);
      for(int i = 0; i < samples; i++) {
          vec2 uv = offset * (1.0 + (float(i) * perStrength)) + defaultCenter;

          // 处理大图边界问题
          if (uv.x < uvRect.x || uv.x > uvRect.x + uvRect.z 
            || uv.y < uvRect.y || uv.y > uvRect.y + uvRect.w) {
            continue;
          }

          color += texture2D(texture, uv);
      }
      color /= float(samples);

      return color;
    }
  #endif

  void main () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      vec2 uv = v_uv0;
      o *= getRadialBlurColor(uv);
    #endif

    o *= v_color;

    ALPHA_TEST(o);

    #if USE_BGRA
      gl_FragColor = o.bgra;
    #else
      gl_FragColor = o.rgba;
    #endif
  }
}%
